#!/bin/sh
# pre-commit —— **刷派生产物**（评测任务集 + 语料锁）。
#
# 为什么有这个：本仓的 `eval/tasks*.json` + `eval/tasks-paired/` 是
# **从语言仓的语料算出来的、但要进仓**的文件 ⇒ 语料变了就得重刷 ⇒
# 忘了 ⇒ **评测在旧题上跑** ⇒ 结论对不上 reality ⇒ 而且没人会发现
# （CI 没有「任务集是最新的」那道门）。
#
# ⚠️ **怎么装**（一次性，仓内）：
#     git config core.hooksPath .githooks
#
# ⚠️ 任务集的重刷要**真跑编译器** ⇒ 要几分钟 ⇒ 只在「该过期时」才跑
#   （语料或生成器的**内容哈希**变了 —— 不是 mtime！mtime 在 CI 上恒判「过期」）。
#
# ⚠️ **为什么 npm 在这里跑、python 只负责判断**：生成器是 `npm run …` ⇒
#   `npm` 是 `.cmd` ⇒ **Windows 的 Python 找不到它**（实测 FileNotFoundError）⇒
#   ⇒ 由 sh（MSYS）跑 npm，python 只回答「该刷吗」+ 记账（写锁）+ stage。
#
# ⚠️ **找不到 python 就直接拦住提交** —— 静默跳过 = 「评测在旧题上跑」
#   且**没人会发现**（跟 CI 里那道门一个道理：门不许静默跳过）。
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

PY=""
for c in python python3 py; do
    # ⚠️ **要真的能跑**（不只是 `command -v` 找得到）—— Windows 上有个
    #   「Microsoft Store 的 python 桩」⇒ 找得到、跑起来退 9009。
    if command -v "$c" >/dev/null 2>&1 \
       && "$c" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
        PY="$c"
        break
    fi
done
if [ -z "$PY" ]; then
    echo "✗ 找不到 python ⇒ **没法判断任务集是不是最新的**" >&2
    echo "  ⇒ 拦住提交（静默跳过 = 评测悄悄跑在旧题上）。" >&2
    echo "  ⇒ 装个 python，或用 git commit --no-verify（自负其责）。" >&2
    exit 1
fi

# 退出码 0 = 该刷；1 = 不用刷
#
# ⚠️ **按产物分开判**（2026-11-20 修的洞）：
#   原来只有一个「全刷」判断 ⇒ 但**推理题集**要真编译 150 道题（十几分钟）
#   ⇒ 改了别的生成器也去重刷它 ⇒ ⇒ 提交被拖死 ⇒ ⇒ 最后就没人提交了。
#   ⇒ ⇒ 拆成三个：**各刷各的**（哪个产物脏了才刷哪个）。
need=0
if "$PY" scripts/dev/refresh-artifacts.py --should-refresh-tasks; then
    echo "[pre-commit] 破坏题任务集过期了 ⇒ 重刷（真跑编译器 ⇒ 要几分钟）……"
    npm run eval:tasks
    need=1
fi
if "$PY" scripts/dev/refresh-artifacts.py --should-refresh-paired; then
    echo "[pre-commit] 配对/翻译题任务集过期了 ⇒ 重刷……"
    npm run eval:tasks:paired
    need=1
fi
if "$PY" scripts/dev/refresh-artifacts.py --should-refresh-quiz; then
    echo "[pre-commit] 推理题任务集过期了 ⇒ 重刷（150 道题要真编译 ⇒ 要十几分钟）……"
    npm run eval:tasks:quiz
    need=1
fi
if [ "$need" = 1 ]; then
    # 记账：把「生成时的语料指纹 + 产物哈希」写进锁 ⇒ CI 那道门才有得比
    "$PY" scripts/dev/refresh-artifacts.py --write-lock
    "$PY" scripts/dev/refresh-artifacts.py --stage
fi
