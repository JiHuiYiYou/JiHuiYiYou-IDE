{
  "name": "jihuiyiyou-ide",
  "version": "0.2.1",
  "description": "JHYY (机会翼游) IDE — 拖块编程 + 文本编辑 + 内嵌 Claude Code",
  "main": "./out/main/index.js",
  "author": "JHYY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run tests/conformance",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "gen:spec": "node scripts/gen-spec-index.mjs",
    "publish:wiki": "node scripts/publish-wiki.mjs",
    "smoke:claude": "vite-node scripts/claude-smoke.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blockly": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
