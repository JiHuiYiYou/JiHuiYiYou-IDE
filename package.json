{
  "name": "jihuiyiyou-ide",
  "version": "0.2.1",
  "description": "JHYY (机会翼游) IDE — 拖块编程 + 文本编辑 + 内嵌 Claude Code",
  "main": "./out/main/index.js",
  "author": "JHYY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run tests/conformance",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "gen:spec": "node scripts/gen-spec-index.mjs",
    "eval:tasks": "vite-node scripts/eval/build-tasks.ts",
    "eval": "vite-node scripts/eval/run-eval.ts",
    "eval:compare": "vite-node scripts/eval/compare.ts",
    "eval:regrade": "vite-node scripts/eval/regrade.ts",
    "eval:probe": "vite-node scripts/jhyy-knowledge-probe.ts",
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "publish:wiki": "node scripts/publish-wiki.mjs",
    "smoke:claude": "vite-node scripts/claude-smoke.ts",
    "smoke:pty": "electron-vite build && electron scripts/pty-host-smoke.cjs",
    "eval:analyze": "vite-node scripts/eval/analyze-turns.ts",
    "eval:tasks:paired": "python scripts/eval/gen-paired-tasks.py",
    "eval:compare-langs": "vite-node scripts/eval/compare-langs.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "blockly": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "build": {
    "npmRebuild": false,
    "files": [
      "**/*",
      "!**/release/**",
      "!**/node_modules/node-pty/prebuilds/**",
      "!**/node_modules/node-pty/build/Release/*.iobj",
      "!**/node_modules/node-pty/build/Release/*.ipdb",
      "!**/node_modules/node-pty/build/Release/*.exp",
      "!**/node_modules/node-pty/build/Release/*.lib",
      "!**/node_modules/node-pty/build/Release/*.pdb",
      "!**/node_modules/node-pty/build/Release/obj/**"
    ],
    "extraResources": [
      {
        "from": "scripts/jhyy-check-hook.mjs",
        "to": "jhyy-check-hook.mjs"
      }
    ]
  }
}
